<Window x:Class="TodoDashboard.Views.DropReasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="放弃行动"
        Width="540" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F6F3EA"
        FontFamily="Segoe UI, Microsoft YaHei"
        UseLayoutRounding="True">

  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#1F4B37" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2E6B4F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#1D1C18" />
      <Setter Property="BorderBrush" Value="#E2DDD0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="11"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F1EDE2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="放弃这条行动" FontSize="24" FontWeight="SemiBold" Foreground="#1D1C18" />
    <TextBlock x:Name="ActionTitleText" Grid.Row="1" FontSize="13" Foreground="#706D63"
               TextWrapping="Wrap" Margin="0,6,0,0" />
    <TextBlock Grid.Row="2" Text="留一句原因，周末复盘时用得上。" FontSize="13" Foreground="#706D63" Margin="0,12,0,0" />

    <StackPanel Grid.Row="3" Margin="0,10,0,0">
      <Border Background="#FFFDF8" BorderBrush="#E2DDD0" BorderThickness="1" CornerRadius="10" Padding="10">
        <TextBox x:Name="ReasonBox" BorderThickness="0" Background="Transparent" FontSize="14"
                 TextWrapping="Wrap" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" />
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button Content="没时间" Tag="没时间" Click="Preset_Click" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,0" />
        <Button Content="不重要" Tag="不重要" Click="Preset_Click" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,0" />
        <Button Content="做不了" Tag="做不了" Click="Preset_Click" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,0" />
        <Button Content="方向变了" Tag="方向变了" Click="Preset_Click" Style="{StaticResource SecondaryButton}" Padding="12,7" />
      </StackPanel>
      <TextBlock x:Name="ErrorText" Foreground="#A8402C" FontSize="12" Margin="0,8,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="取消" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
      <Button Content="确认放弃" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
    </StackPanel>
  </Grid>
</Window>
