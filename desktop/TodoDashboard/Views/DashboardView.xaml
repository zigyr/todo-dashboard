<UserControl x:Class="TodoDashboard.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

  <UserControl.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDF8" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#F1EDE2" />
    <SolidColorBrush x:Key="InkBrush" Color="#1D1C18" />
    <SolidColorBrush x:Key="MutedBrush" Color="#706D63" />
    <SolidColorBrush x:Key="LineBrush" Color="#E2DDD0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2E6B4F" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#1F4B37" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5EFE7" />
    <SolidColorBrush x:Key="DangerBrush" Color="#A8402C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F8E6E1" />

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="StatCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentDeepBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,26,32,24">
      <TextBlock Text="今天" Style="{StaticResource Eyebrow}" />
      <TextBlock Text="今天，只做一件。" FontSize="42" FontWeight="SemiBold"
                 Foreground="{StaticResource InkBrush}" Margin="0,8,0,10" />
      <TextBlock Text="从 AI 拆解出来的行动里，选一件现在做的。做完或放弃，都留个记录。"
                 Style="{StaticResource MutedText}" FontSize="15" TextWrapping="Wrap" MaxWidth="700" />

      <UniformGrid Columns="4" Margin="0,22,0,0">
        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="{Binding NextCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="待办" Style="{StaticResource MutedText}" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="{Binding DoingCount}" FontSize="26" FontWeight="SemiBold" Foreground="#B07A2A" />
            <TextBlock Text="进行中" Style="{StaticResource MutedText}" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="{Binding DoneCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="已完成" Style="{StaticResource MutedText}" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="{Binding DroppedCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
            <TextBlock Text="已放弃" Style="{StaticResource MutedText}" FontSize="12" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="12,9" Margin="0,14,0,0"
              Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding Notice}" Foreground="{StaticResource AccentDeepBrush}" FontSize="12" TextWrapping="Wrap" />
      </Border>

      <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0"
              Visibility="{Binding HasCurrentAction, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <Grid>
            <TextBlock Text="现在做" Style="{StaticResource Eyebrow}" />
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="999" Padding="9,4" HorizontalAlignment="Right">
              <TextBlock Text="{Binding CurrentAction.BadgeText}" Foreground="{StaticResource AccentDeepBrush}" FontSize="11" />
            </Border>
          </Grid>
          <TextBlock Text="{Binding CurrentAction.Title}" FontSize="24" FontWeight="SemiBold"
                     Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,8,0,6" />
          <TextBlock Text="{Binding CurrentAction.NextAction}" FontSize="14" Foreground="{StaticResource AccentDeepBrush}"
                     TextWrapping="Wrap" Margin="0,2,0,6" />
          <TextBlock Text="{Binding CurrentAction.SourceText}" Style="{StaticResource MutedText}" FontSize="12"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="开始" Command="{Binding StartActionCommand}" CommandParameter="{Binding CurrentAction}"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                    Visibility="{Binding CurrentAction.IsNext, Converter={StaticResource BoolToVis}}" />
            <Button Content="完成" Command="{Binding CompleteActionCommand}" CommandParameter="{Binding CurrentAction}"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                    Visibility="{Binding CurrentAction.IsDoing, Converter={StaticResource BoolToVis}}" />
            <Button Content="放弃" Command="{Binding DropActionCommand}" CommandParameter="{Binding CurrentAction}"
                    Style="{StaticResource SecondaryButton}"
                    Visibility="{Binding CurrentAction.CanDrop, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Grid Margin="0,22,0,10">
        <TextBlock Text="全部行动" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                  Width="130" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Actions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                    <Border CornerRadius="999" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="doing">
                              <Setter Property="Background" Value="#F6E9CF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="done">
                              <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="dropped">
                              <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentDeepBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding NextAction}" FontSize="12.5" Foreground="{StaticResource AccentDeepBrush}"
                             TextWrapping="Wrap" Margin="0,5,0,0" />
                  <TextBlock Text="{Binding BadgeText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                  <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap" Margin="0,3,0,0" />
                  <TextBlock Text="{Binding DropReasonText}" FontSize="11" Foreground="{StaticResource DangerBrush}"
                             TextWrapping="Wrap" Margin="0,4,0,0"
                             Visibility="{Binding HasDropReason, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="开始" Command="{Binding DataContext.StartActionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                          CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                          Visibility="{Binding IsNext, Converter={StaticResource BoolToVis}}" />
                  <Button Content="完成" Command="{Binding DataContext.CompleteActionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                          CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                          Visibility="{Binding IsDoing, Converter={StaticResource BoolToVis}}" />
                  <Button Content="放弃" Command="{Binding DataContext.DropActionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                          CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}"
                          Visibility="{Binding CanDrop, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Background="#FAF8F1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
              CornerRadius="18" Padding="28" Margin="0,6,0,0"
              Visibility="{Binding HasNoActions, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Text="还没有行动" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
          <TextBlock Text="{Binding EmptyText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
          <Button Content="去捕获一篇文章" Command="{Binding GoCaptureCommand}" Style="{StaticResource PrimaryButton}"
                  HorizontalAlignment="Left" Margin="0,14,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
