<Window x:Class="TodoDashboard.Views.ApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 DeepSeek API Key"
        Width="560" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F6F3EA"
        FontFamily="Segoe UI, Microsoft YaHei"
        UseLayoutRounding="True">

  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#1F4B37" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2E6B4F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#1D1C18" />
      <Setter Property="BorderBrush" Value="#E2DDD0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="11"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F1EDE2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="连接 DeepSeek" FontSize="26" FontWeight="SemiBold" Foreground="#1D1C18" />
    <TextBlock Grid.Row="1" Text="AI 拆解需要 DeepSeek API Key。它只会保存在 Windows 凭据管理器，不写进项目文件。"
               FontSize="13" Foreground="#706D63" TextWrapping="Wrap" Margin="0,8,0,0" />

    <Border Grid.Row="2" Background="#FFFDF8" BorderBrush="#E2DDD0" BorderThickness="1" CornerRadius="11" Margin="0,18,0,0" Padding="12,4">
      <PasswordBox x:Name="KeyBox" BorderThickness="0" Background="Transparent" FontSize="14"
                   Padding="2,8" VerticalContentAlignment="Center" />
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
      <TextBlock Text="没有 Key？" FontSize="12" Foreground="#706D63" />
      <Button x:Name="LinkButton" Content="去 DeepSeek 开放平台获取 ↗" Click="Link_Click"
              Background="Transparent" BorderThickness="0" Foreground="#1F4B37"
              FontSize="12" Padding="2,0" Cursor="Hand" />
    </StackPanel>

    <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="#A8402C" FontSize="12"
               TextWrapping="Wrap" Margin="0,10,0,0" />

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="取消" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
      <Button Content="保存并继续" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
    </StackPanel>
  </Grid>
</Window>
