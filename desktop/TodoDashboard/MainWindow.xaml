<Window x:Class="TodoDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TodoDashboard.Views"
        Title="Todo Dashboard"
        Width="1180" Height="820" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#F6F3EA"
        FontFamily="Segoe UI, Microsoft YaHei"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#F6F3EA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDF8" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#F1EDE2" />
    <SolidColorBrush x:Key="InkBrush" Color="#1D1C18" />
    <SolidColorBrush x:Key="MutedBrush" Color="#706D63" />
    <SolidColorBrush x:Key="LineBrush" Color="#E2DDD0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2E6B4F" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#1F4B37" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5EFE7" />
    <SolidColorBrush x:Key="DangerBrush" Color="#A8402C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F8E6E1" />

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="22" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.10" Color="#3D3726" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="StatTile" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="UrlTextBox" TargetType="TextBox">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,0,12,0" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentDeepBrush}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentDeepBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="11"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RecentButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,22,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" />
              <Border x:Name="NavUnderline" Height="2" Background="Transparent" Margin="0,4,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter TargetName="NavUnderline" Property="Background" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding CaptureCommand}" />
    <KeyBinding Key="Escape" Command="{Binding DiscardCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <Border Grid.Row="0" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
            Padding="32,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
          <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentDeepBrush}">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Todo Dashboard" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
            <TextBlock Text="READING → ACTION" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <RadioButton Content="今天" GroupName="MainNav" Style="{StaticResource NavRadio}"
                       IsChecked="{Binding IsTodayView, Mode=TwoWay}" />
          <RadioButton Content="捕获" GroupName="MainNav" Style="{StaticResource NavRadio}"
                       IsChecked="{Binding IsCaptureView, Mode=TwoWay}" />
          <RadioButton Content="回顾" GroupName="MainNav" Style="{StaticResource NavRadio}"
                       IsChecked="{Binding IsReviewView, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="#4F9B74" Margin="0,0,8,0" />
          <TextBlock Text="本地存储 · 无账号" FontSize="12" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Today dashboard -->
    <Grid Grid.Row="1" Visibility="{Binding IsTodayView, Converter={StaticResource BoolToVis}}">
      <views:DashboardView DataContext="{Binding Actions}" />
    </Grid>

    <!-- Review placeholder -->
    <Grid Grid.Row="1" Visibility="{Binding IsReviewView, Converter={StaticResource BoolToVis}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,24">
          <TextBlock Text="回顾" Style="{StaticResource Eyebrow}" />
          <TextBlock Text="周复盘，下一步做。" FontSize="42" FontWeight="SemiBold"
                     Foreground="{StaticResource InkBrush}" Margin="0,8,0,10" />
          <TextBlock Text="这里会统计本周完成、放弃和原因，并生成一份 review-YYYY-Www.md。"
                     Style="{StaticResource MutedText}" FontSize="15" TextWrapping="Wrap" MaxWidth="700" />
          <Border Background="#FAF8F1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  CornerRadius="18" Padding="28" Margin="0,22,0,0">
            <TextBlock Text="先把「今天」和「捕获」用顺，周复盘会在下一批接上。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Main content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding IsCaptureView, Converter={StaticResource BoolToVis}}">
      <Grid Margin="32,26,32,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="1.9*" />
        </Grid.ColumnDefinitions>

        <!-- Left column: recent + workspace -->
        <StackPanel Grid.Column="0">
          <Border Style="{StaticResource CardBorder}" Padding="20">
            <StackPanel>
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="16" />
                  <TextBlock Text="最近抓取" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                </StackPanel>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right" Padding="6" ToolTip="刷新">
                  <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                </Button>
              </Grid>

              <TextBlock Text="{Binding RecentEmptyText}" Style="{StaticResource MutedText}"
                         Margin="0,12,0,0"
                         Visibility="{Binding HasNoRecent, Converter={StaticResource BoolToVis}}" />

              <ItemsControl ItemsSource="{Binding Recent}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{Binding Url}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RecentButton}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                              <Setter Property="Background" Value="#EAF2EC" />
                              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DisplayMeta}" FontSize="11.5"
                                     Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                          <TextBlock Text="{Binding DisplayDate}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                          <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                     Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,18,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="17" />
                <TextBlock Text="本地工作区" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
              </StackPanel>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="10,9">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" />
                    <TextBlock Text="{Binding WorkspacePath}" FontSize="11" Foreground="#4C4A41"
                               Margin="6,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Button Grid.Column="1" Content="打开 ↗" Command="{Binding OpenWorkspaceCommand}"
                        Style="{StaticResource LinkButton}" FontSize="12" Margin="6,0,0,0"
                        AutomationProperties.AutomationId="OpenWorkspaceButton"
                        AutomationProperties.Name="打开工作区文件夹" />
              </Grid>

              <UniformGrid Columns="3" Margin="0,12,0,0">
                <Border Style="{StaticResource StatTile}" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="15" />
                    <TextBlock Text="{Binding SourceCountLabel}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" Margin="0,6,0,0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="15" />
                    <TextBlock Text="JSON + Markdown" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                  <StackPanel>
                    <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="15" />
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,6,0,0">
                      <Run Text="最近：" /><Run Text="{Binding LastCapturedText, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12" />
                <TextBlock Text="数据就是文件，可以用记事本或 Obsidian 打开，随时带走。"
                           Style="{StaticResource MutedText}" FontSize="11.5" Margin="6,0,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Right column: capture + preview -->
        <StackPanel Grid.Column="2">
          <TextBlock Text="第一步 · 捕获" Style="{StaticResource Eyebrow}" />
          <TextBlock FontSize="50" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                     TextWrapping="Wrap" Margin="0,10,0,14" LineHeight="58">
            <Run Text="把一篇博客，" /><LineBreak /><Run Text="变成下一步。" Foreground="{StaticResource AccentBrush}" />
          </TextBlock>
          <TextBlock Text="粘贴网址。程序抓取正文并保存到本地；AI 拆解和行动仪表盘在下一步接入。"
                     Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="700" FontSize="16" />

          <Border Style="{StaticResource CardBorder}" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="博客网址" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="52" CornerRadius="12" Margin="0,0,12,0">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                          <Setter Property="BorderThickness" Value="2" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE71B;" Style="{StaticResource Icon}" Margin="14,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource UrlTextBox}"
                             AutomationProperties.AutomationId="UrlInput"
                             AutomationProperties.Name="博客网址" />
                  </Grid>
                </Border>
                <Button Grid.Column="1" Content="抓取正文  →" Command="{Binding CaptureCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="132"
                        AutomationProperties.AutomationId="CaptureButton"
                        AutomationProperties.Name="抓取正文" />
              </Grid>

              <ProgressBar Height="3" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"
                           Background="Transparent" BorderThickness="0" Margin="0,14,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

              <TextBlock Text="支持普通博客文章。付费墙、纯 JS 渲染的页面可能抓不到。"
                         Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" />

              <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="#ECCBC2"
                      BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,12,0,0"
                      Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" FontSize="13" />
              </Border>
            </StackPanel>
          </Border>

          <!-- Preview card -->
          <Border Style="{StaticResource CardBorder}" Margin="0,20,0,0"
                  Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <Grid>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource AccentSoftBrush}">
                      <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                 Foreground="{StaticResource AccentDeepBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="抓取成功 · 先确认再保存" Style="{StaticResource Eyebrow}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Preview.Title}" FontSize="25" FontWeight="SemiBold"
                             Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,10,0,6" />
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="12" />
                    <TextBlock Text="作者：" Style="{StaticResource MutedText}" FontSize="12"
                               Margin="5,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PreviewAuthor}" Style="{StaticResource MutedText}" FontSize="12"
                               Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="|" Style="{StaticResource MutedText}" FontSize="12"
                               Foreground="{StaticResource LineBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="12" />
                    <TextBlock Text="发布：" Style="{StaticResource MutedText}" FontSize="12"
                               Margin="5,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PreviewPublished}" Style="{StaticResource MutedText}" FontSize="12"
                               Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="|" Style="{StaticResource MutedText}" FontSize="12"
                               Foreground="{StaticResource LineBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE890;" Style="{StaticResource Icon}" FontSize="12" />
                    <TextBlock Text="{Binding PreviewWordCount}" Style="{StaticResource MutedText}" FontSize="12"
                               Margin="5,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="999"
                        Padding="10,5" VerticalAlignment="Top" HorizontalAlignment="Right">
                  <TextBlock Text="未保存" Foreground="{StaticResource AccentDeepBrush}" FontSize="11" FontWeight="SemiBold" />
                </Border>
              </Grid>

              <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}"
                      BorderThickness="4,0,0,0" CornerRadius="0,10,10,0" Padding="16" Margin="0,18,0,0">
                <TextBlock Text="{Binding Preview.Excerpt}" Foreground="#3F3D35" FontSize="14"
                           TextWrapping="Wrap" LineHeight="24" />
              </Border>

              <Expander Header="查看正文" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,14,0,0">
                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14" Margin="0,10,0,0">
                  <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding Preview.Text}" IsReadOnly="True" TextWrapping="Wrap"
                             BorderThickness="0" Background="Transparent" Foreground="{StaticResource InkBrush}"
                             FontSize="13" />
                  </ScrollViewer>
                </Border>
              </Expander>

              <Grid Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <Button Content="{Binding AnalyzeButtonText}" Command="{Binding AnalyzeCommand}"
                          Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                          AutomationProperties.AutomationId="AnalyzeButton" />
                  <Button Content="保存原文" Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                  <Button Content="放弃" Command="{Binding DiscardCommand}" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <Button Content="打开原文 ↗" Command="{Binding OpenUrlCommand}" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- AI analysis card -->
          <Border Style="{StaticResource CardBorder}" Margin="0,20,0,0"
                  Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <Grid>
                <StackPanel>
                  <TextBlock Text="AI 拆解结果" Style="{StaticResource Eyebrow}" />
                  <TextBlock Text="{Binding Analysis.Summary}" FontSize="14" Foreground="#3F3D35"
                             TextWrapping="Wrap" LineHeight="24" Margin="0,8,0,0" />
                </StackPanel>
                <Button Content="清空" Command="{Binding ClearAnalysisCommand}" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Analysis.Actions}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                  VerticalAlignment="Top" Margin="0,2,10,0" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                     Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Outcome}" Style="{StaticResource MutedText}" FontSize="12"
                                     TextWrapping="Wrap" Margin="0,4,0,0" />
                          <TextBlock Text="{Binding NextAction}" FontSize="12" Foreground="{StaticResource AccentDeepBrush}"
                                     TextWrapping="Wrap" Margin="0,4,0,0" />
                          <TextBlock Text="{Binding BadgeText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                     Margin="0,6,0,0" />
                          <TextBlock Text="{Binding Quote}" FontSize="11" FontStyle="Italic"
                                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button Content="保存选中的行动" Command="{Binding SaveActionsCommand}" Style="{StaticResource PrimaryButton}" />
                  <Button Content="重新分析" Command="{Binding AnalyzeCommand}" Style="{StaticResource SecondaryButton}"
                          Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding SelectedActionText}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>

              <TextBlock Text="{Binding ActionSaveMessage}" Foreground="{StaticResource AccentDeepBrush}" FontSize="12"
                         TextWrapping="Wrap" Margin="0,10,0,0"
                         Visibility="{Binding HasActionSaveMessage, Converter={StaticResource BoolToVis}}" />

              <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="#ECCBC2" BorderThickness="1"
                      CornerRadius="10" Padding="12,9" Margin="0,10,0,0"
                      Visibility="{Binding HasAnalysisError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding AnalysisError}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" FontSize="12" />
              </Border>
            </StackPanel>
          </Border>

          <!-- Saved card -->
          <Border Style="{StaticResource CardBorder}" Margin="0,20,0,0"
                  Visibility="{Binding HasSaved, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentSoftBrush}">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentDeepBrush}"
                           FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,16,0">
                <TextBlock Text="已保存到本地" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding Saved.Title}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,6,0,4" />
                <TextBlock Text="正文和元数据已经写入工作区：" Style="{StaticResource MutedText}" Margin="0,2,0,2" />
                <TextBlock Text="{Binding Saved.MarkdownPath}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,2" />
                <TextBlock Text="{Binding Saved.JsonPath}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" />
              </StackPanel>
              <Button Grid.Column="2" Content="再抓一篇" Command="{Binding DiscardCommand}"
                      Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- Empty card -->
          <Border Background="#FAF8F1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  CornerRadius="18" Padding="28" Margin="0,20,0,0"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="这里会出现预览" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="粘贴网址，先看看抓到了什么。" FontSize="20" FontWeight="SemiBold"
                         Foreground="{StaticResource InkBrush}" Margin="0,8,0,8" />
              <TextBlock Text="不会自动生成任务。你确认正文没问题后，才会写入本地。下一步才会让 AI 把它拆成行动。"
                         Style="{StaticResource MutedText}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="999" Padding="12,7" Margin="0,0,8,0">
                  <TextBlock Text="1 · 粘贴" Style="{StaticResource MutedText}" FontSize="12" />
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="999" Padding="12,7" Margin="0,0,8,0">
                  <TextBlock Text="2 · 预览" Style="{StaticResource MutedText}" FontSize="12" />
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="999" Padding="12,7">
                  <TextBlock Text="3 · 保存" Style="{StaticResource MutedText}" FontSize="12" />
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
            Padding="32,14">
      <Grid>
        <TextBlock Text="Todo Dashboard · 0.1.0" FontSize="11" Foreground="{StaticResource MutedBrush}" />
        <TextBlock Text="Ctrl + Enter 抓取 · Esc 重置" FontSize="11" Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Right" />
      </Grid>
    </Border>
  </Grid>
</Window>
