<Window x:Class="TodoDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo Dashboard"
        Width="1100" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F6F3EA"
        FontFamily="Segoe UI, Microsoft YaHei"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDF8" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#F1EDE2" />
    <SolidColorBrush x:Key="InkBrush" Color="#1D1C18" />
    <SolidColorBrush x:Key="MutedBrush" Color="#706D63" />
    <SolidColorBrush x:Key="LineBrush" Color="#E2DDD0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2E6B4F" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#1F4B37" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5EFE7" />
    <SolidColorBrush x:Key="DangerBrush" Color="#A8402C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F8E6E1" />

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="26" ShadowDepth="10" Opacity="0.08" Color="#3D3726" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentDeepBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="32,14">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentDeepBrush}">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Todo Dashboard" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
            <TextBlock Text="READING → SUMMARY" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="#4F9B74" Margin="0,0,8,0" />
          <TextBlock Text="不保存正文 · 只给原文链接" FontSize="12" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Width="840" HorizontalAlignment="Center" Margin="0,40,0,32">
        <TextBlock Text="阅读摘要" Style="{StaticResource Eyebrow}" />
        <TextBlock Text="把一篇博客，读成一段摘要。" FontSize="44" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,10,0,12" LineHeight="52" />
        <TextBlock Text="粘贴网址。AI 读完，给你摘要、关键观点和原文链接。不保存正文，不生成任务。"
                   Style="{StaticResource MutedText}" FontSize="15" TextWrapping="Wrap" />

        <Border Style="{StaticResource CardBorder}" Margin="0,24,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Height="52" CornerRadius="12" Margin="0,0,12,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                      <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                             Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,8,0" />
                  <TextBox Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                           BorderThickness="0" Background="Transparent" FontSize="15"
                           VerticalContentAlignment="Center" Padding="0,0,12,0"
                           AutomationProperties.AutomationId="UrlInput"
                           AutomationProperties.Name="博客网址" />
                </Grid>
              </Border>
              <Button Grid.Column="1" Content="{Binding ButtonText}" Command="{Binding SummarizeCommand}"
                      Style="{StaticResource PrimaryButton}" MinWidth="124"
                      AutomationProperties.AutomationId="SummarizeButton"
                      AutomationProperties.Name="生成摘要" />
            </Grid>

            <ProgressBar Height="3" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"
                         Background="Transparent" BorderThickness="0" Margin="0,14,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="#ECCBC2" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                         TextWrapping="Wrap" FontSize="13" />
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,20,0,0"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <Grid>
              <StackPanel>
                <TextBlock Text="AI 摘要" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding ResultTitle}" FontSize="26" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,8,0,6" />
                <TextBlock Text="{Binding ResultMeta}" Style="{StaticResource MutedText}" FontSize="12" />
              </StackPanel>
              <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="999" Padding="10,5"
                      VerticalAlignment="Top" HorizontalAlignment="Right">
                <TextBlock Text="仅摘要" Foreground="{StaticResource AccentDeepBrush}" FontSize="11" FontWeight="SemiBold" />
              </Border>
            </Grid>

            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="4,0,0,0" CornerRadius="0,10,10,0" Padding="18" Margin="0,18,0,0">
              <TextBlock Text="{Binding Summary}" FontSize="15.5" Foreground="#3F3D35"
                         TextWrapping="Wrap" LineHeight="26" />
            </Border>

            <TextBlock Text="文章在讲什么" Style="{StaticResource Eyebrow}" Margin="0,20,0,0" />
            <TextBlock Text="{Binding Explanation}" FontSize="14" Foreground="#3F3D35"
                       TextWrapping="Wrap" LineHeight="25" Margin="0,8,0,0" />

            <TextBlock Text="关键观点" Style="{StaticResource Eyebrow}" Margin="0,20,0,0" />
            <ItemsControl ItemsSource="{Binding Analysis.KeyIdeas}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                          BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                      <TextBlock Text="{Binding Idea}" FontSize="13.5" FontWeight="SemiBold"
                                 Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding WhyItMatters}" Style="{StaticResource MutedText}" FontSize="12"
                                 TextWrapping="Wrap" Margin="0,4,0,0" />
                      <TextBlock Text="{Binding Quote}" FontSize="11.5" FontStyle="Italic"
                                 Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="14" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="{Binding WhoItSuits}" FontSize="12" Foreground="{StaticResource AccentDeepBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ReadingTip}" FontSize="12" Foreground="{StaticResource AccentDeepBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasReadingTip, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
              <StackPanel Orientation="Horizontal">
                <Button Content="打开原文 ↗" Command="{Binding OpenUrlCommand}" Style="{StaticResource PrimaryButton}"
                        AutomationProperties.AutomationId="OpenOriginalButton" />
                <Button Content="换一篇" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButton}"
                        Margin="10,0,0,0" />
              </StackPanel>
              <TextBlock Text="原文链接来自你粘贴的网址，正文不会保存到本地。"
                         Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right"
                         VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Background="#FAF8F1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="18" Padding="28" Margin="0,20,0,0"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="粘贴一个博客网址" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
            <TextBlock Text="摘要会出现在这里。不保存正文，不生成任务，只给你一个直达原文的链接。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="32,14">
      <Grid>
        <TextBlock Text="Todo Dashboard · 0.1.0" FontSize="11" Foreground="{StaticResource MutedBrush}" />
        <TextBlock Text="不保存正文 · 只给原文链接" FontSize="11" Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Right" />
      </Grid>
    </Border>
  </Grid>
</Window>
